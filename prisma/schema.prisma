// Planner database schema (blueprint Section 3).
// Prisma 7: connection URLs live in prisma.config.ts (CLI) and src/lib/db.ts
// (runtime driver adapter), not in this file.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Users ----------

model User {
  id              String   @id @default(cuid())
  authId          String   @unique @db.Uuid // Supabase auth.users.id
  email           String   @unique
  name            String?
  timezone        String   @default("America/New_York")
  dayStartsAt     Int      @default(240) // minutes after midnight
  morningRemindAt Int? // minutes after midnight
  eveningRemindAt Int?
  createdAt       DateTime @default(now())

  goals          Goal[]
  milestones     Milestone[]
  tasks          Task[]
  journalEntries JournalEntry[]
  events         ActivityEvent[]
}

// ---------- Goals ----------

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ProgressMode {
  MILESTONES
  METRIC
}

model Goal {
  id            String       @id @default(cuid())
  userId        String
  title         String
  why           String?
  color         String       @default("#34C759") // one of the 5 goal colors (src/lib/domain/goal-colors.ts)
  status        GoalStatus   @default(ACTIVE)
  progressMode  ProgressMode @default(MILESTONES)
  metricUnit    String? // "km", "pages", "$"
  metricTarget  Decimal?     @db.Decimal(12, 2)
  metricCurrent Decimal      @default(0) @db.Decimal(12, 2) // cached
  progress      Float        @default(0) // cached, 0..1
  startDate     DateTime     @db.Date
  targetDate    DateTime?    @db.Date
  rank          String // fractional index
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones   Milestone[]
  tasks        Task[]
  journalLinks JournalLink[]
  events       ActivityEvent[]

  @@index([userId, status])
}

enum MilestoneStatus {
  OPEN
  DONE
}

model Milestone {
  id          String          @id @default(cuid())
  userId      String // denormalized for row-level auth
  goalId      String
  title       String
  description String?
  status      MilestoneStatus @default(OPEN)
  weight      Int             @default(1) // 1..3
  progress    Float           @default(0) // cached, 0..1
  targetDate  DateTime?       @db.Date
  rank        String
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal         Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks        Task[]
  journalLinks JournalLink[]

  @@index([goalId, rank])
}

// ---------- Planner ----------

enum TaskStatus {
  TODO
  DONE
  SKIPPED
}

enum Recurrence {
  NONE
  DAILY
  WEEKDAYS
  WEEKLY
}

model Task {
  id                 String     @id @default(cuid())
  userId             String
  goalId             String? // set when linked; must equal milestone.goalId
  milestoneId        String?
  title              String
  notes              String?
  status             TaskStatus @default(TODO)
  isTopThree         Boolean    @default(false)
  scheduledDate      DateTime?  @db.Date // null = backlog
  startMin           Int? // null = on the day, not time-blocked
  durationMin        Int?       @default(30)
  contribution       Decimal?   @db.Decimal(12, 2) // metric-goal amount
  rank               String // order within its list/day
  carryCount         Int        @default(0)
  recurrence         Recurrence @default(NONE)
  recurrenceParentId String? // template task for generated instances
  completedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal         Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestone    Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  journalLinks JournalLink[]

  @@unique([recurrenceParentId, scheduledDate]) // one instance per day
  @@index([userId, scheduledDate])
  @@index([userId, scheduledDate, startMin])
  @@index([milestoneId, status])
  @@index([goalId, status])
}

// ---------- Journal ----------

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date // local calendar day
  content   Json // Tiptap JSON doc
  plainText String   @default("") // for search
  intention String? // "one thing for tomorrow"
  mood      Int? // 1..5
  version   Int      @default(1) // optimistic concurrency
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  links JournalLink[]

  @@unique([userId, date])
}

enum LinkTarget {
  GOAL
  MILESTONE
  TASK
}

model JournalLink {
  id          String     @id @default(cuid())
  entryId     String
  blockId     String // Tiptap UniqueID of the block
  targetType  LinkTarget
  goalId      String?
  milestoneId String?
  taskId      String?
  snippet     String // block text, for timelines
  createdAt   DateTime   @default(now())

  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  goal      Goal?        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  milestone Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([entryId, blockId, targetType, goalId, milestoneId, taskId])
  @@index([goalId])
  @@index([milestoneId])
}

// ---------- Event log ----------

enum EventType {
  TASK_COMPLETED
  TASK_UNCOMPLETED
  TASK_CARRIED
  TASK_SKIPPED
  MILESTONE_COMPLETED
  GOAL_COMPLETED
  DAY_PLANNED
  DAY_CLOSED
}

model ActivityEvent {
  id          String    @id @default(cuid())
  userId      String
  type        EventType
  localDate   DateTime  @db.Date
  occurredAt  DateTime  @default(now())
  goalId      String?
  milestoneId String?
  taskId      String?
  payload     Json? // { before, after, delta }

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, localDate])
  @@index([goalId, occurredAt])
}
